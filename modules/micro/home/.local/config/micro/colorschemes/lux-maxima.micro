# Editor
color-link default "#4d4c4c,#ffffff"
color-link selection "#4d4c4c,#ccd8f3"
color-link cursor-line "#f8f8f8"
color-link color-column "#f6f6f6"
color-link indent-char "#e4e4e4"
color-link line-number "#d9d8d8,#ffffff"
color-link current-line-number "#4d4c4c,#f8f8f8"
color-link match-brace "bold #252424,#ccd8f3"
color-link hlsearch "#4d4c4c,#99b2e7"
color-link tab-error ",#edd1cb"
color-link trailingws ",#edd1cb"
color-link scrollbar "#e4e4e4,#ffffff"
color-link divider "#e6e6e6,#ffffff"

# Gutter
color-link gutter-info "#3365cf,#ffffff"
color-link gutter-warning "#846700,#ffffff"
color-link gutter-error "#b64630,#ffffff"
color-link diff-added "#007c32"
color-link diff-modified "#3365cf"
color-link diff-deleted "#b64630"

# Interface
color-link statusline "#797878,#eeeeee"
color-link statusline.inactive "#a7a7a7,#f7f7f7"
color-link statusline.suggestions "#797878,#f7f7f7"
color-link tabbar "#797878,#f7f7f7"
color-link tabbar.active "#4d4c4c,#ffffff"
color-link message "#4d4c4c,#ffffff"
color-link error-message "bold #b64630,#ffffff"

# Syntax
color-link comment "#a7a7a7"
color-link comment.bright "#a7a7a7"
color-link identifier "#846700"
color-link identifier.class "#3365cf"
color-link identifier.macro "#b3416e"
color-link identifier.var "#4d4c4c"
color-link constant "#4d4c4c"
color-link constant.bool "#b3416e"
color-link constant.number "#9e47a4"
color-link constant.specialChar "#9e47a4"
color-link constant.string "#007c32"
color-link constant.string.url "underline #3365cf"
color-link statement "#797878"
color-link symbol "#797878"
color-link symbol.brackets "#797878"
color-link symbol.operator "#797878"
color-link symbol.tag "#797878"
color-link preproc "#797878"
color-link preproc.shebang "#a7a7a7"
color-link type "#797878"
color-link type.keyword "#797878"
color-link special "#b3416e"
color-link underlined "underline #3365cf"
color-link error "italic underline #b64630"
color-link todo "bold #846700"
color-link ignore "#d9d8d8"
