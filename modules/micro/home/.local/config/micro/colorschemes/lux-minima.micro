# Editor
color-link default "#4a4b4f,#fff7e5"
color-link selection "#4a4b4f,#ccd2e0"
color-link cursor-line "#f8f0df"
color-link color-column "#f6eedd"
color-link indent-char "#e4ddcf"
color-link line-number "#d8d2c5,#fff7e5"
color-link current-line-number "#4a4b4f,#f8f0df"
color-link match-brace "bold #22242d,#ccd2e0"
color-link hlsearch "#4a4b4f,#99aeda"
color-link tab-error ",#edcab8"
color-link trailingws ",#edcab8"
color-link scrollbar "#e4ddcf,#fff7e5"
color-link divider "#e7dfcd,#fff7e5"

# Gutter
color-link gutter-info "#3365cf,#fff7e5"
color-link gutter-warning "#846700,#fff7e5"
color-link gutter-error "#b64630,#fff7e5"
color-link diff-added "#007c32"
color-link diff-modified "#3365cf"
color-link diff-deleted "#b64630"

# Interface
color-link statusline "#777574,#efe6d5"
color-link statusline.inactive "#a6a29c,#f7efdd"
color-link statusline.suggestions "#777574,#f7efdd"
color-link tabbar "#777574,#f7efdd"
color-link tabbar.active "#4a4b4f,#fff7e5"
color-link message "#4a4b4f,#fff7e5"
color-link error-message "bold #b64630,#fff7e5"

# Syntax
color-link comment "#a6a29c"
color-link comment.bright "#a6a29c"
color-link identifier "#846700"
color-link identifier.class "#3365cf"
color-link identifier.macro "#b3416e"
color-link identifier.var "#4a4b4f"
color-link constant "#4a4b4f"
color-link constant.bool "#b3416e"
color-link constant.number "#9e47a4"
color-link constant.specialChar "#9e47a4"
color-link constant.string "#007c32"
color-link constant.string.url "underline #3365cf"
color-link statement "#777574"
color-link symbol "#777574"
color-link symbol.brackets "#777574"
color-link symbol.operator "#777574"
color-link symbol.tag "#777574"
color-link preproc "#777574"
color-link preproc.shebang "#a6a29c"
color-link type "#777574"
color-link type.keyword "#777574"
color-link special "#b3416e"
color-link underlined "underline #3365cf"
color-link error "italic underline #b64630"
color-link todo "bold #846700"
color-link ignore "#d8d2c5"
