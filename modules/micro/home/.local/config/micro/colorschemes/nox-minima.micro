# Editor
color-link default "#bfb9b0,#181b25"
color-link selection "#bfb9b0,#263456"
color-link cursor-line "#1e212a"
color-link color-column "#21232c"
color-link indent-char "#313339"
color-link line-number "#35373e,#181b25"
color-link current-line-number "#bfb9b0,#1e212a"
color-link match-brace "bold #f2eada,#263456"
color-link hlsearch "#bfb9b0,#354d88"
color-link tab-error ",#482c2d"
color-link trailingws ",#482c2d"
color-link scrollbar "#303239,#181b25"
color-link divider "#0e111a,#181b25"

# Gutter
color-link gutter-info "#517fea,#181b25"
color-link gutter-warning "#a37f00,#181b25"
color-link gutter-error "#d75e46,#181b25"
color-link diff-added "#249746"
color-link diff-modified "#517fea"
color-link diff-deleted "#d75e46"

# Interface
color-link statusline "#8e8b88,#11141d"
color-link statusline.inactive "#605f62,#13161f"
color-link statusline.suggestions "#8e8b88,#13161f"
color-link tabbar "#8e8b88,#13161f"
color-link tabbar.active "#bfb9b0,#181b25"
color-link message "#bfb9b0,#181b25"
color-link error-message "bold #d75e46,#181b25"

# Syntax
color-link comment "#605f62"
color-link comment.bright "#605f62"
color-link identifier "#c56e00"
color-link identifier.class "#008cc7"
color-link identifier.macro "#d35a87"
color-link identifier.var "#bfb9b0"
color-link constant "#bfb9b0"
color-link constant.bool "#d35a87"
color-link constant.number "#916fe3"
color-link constant.specialChar "#916fe3"
color-link constant.string "#798c00"
color-link constant.string.url "underline #008cc7"
color-link statement "#8e8b88"
color-link symbol "#8e8b88"
color-link symbol.brackets "#8e8b88"
color-link symbol.operator "#8e8b88"
color-link symbol.tag "#8e8b88"
color-link preproc "#8e8b88"
color-link preproc.shebang "#605f62"
color-link type "#8e8b88"
color-link type.keyword "#8e8b88"
color-link special "#d35a87"
color-link underlined "underline #008cc7"
color-link error "italic underline #d75e46"
color-link todo "bold #a37f00"
color-link ignore "#35373e"
