# Editor
color-link default "#c0bfbf,#1c1b1b"
color-link selection "#c0bfbf,#29344f"
color-link cursor-line "#222121"
color-link color-column "#242424"
color-link indent-char "#343434"
color-link line-number "#383838,#1c1b1b"
color-link current-line-number "#c0bfbf,#222121"
color-link match-brace "bold #f2f2f2,#29344f"
color-link hlsearch "#c0bfbf,#374d83"
color-link tab-error ",#4b2c26"
color-link trailingws ",#4b2c26"
color-link scrollbar "#333232,#1c1b1b"
color-link divider "#121111,#1c1b1b"

# Gutter
color-link gutter-info "#517fea,#1c1b1b"
color-link gutter-warning "#a37f00,#1c1b1b"
color-link gutter-error "#d75e46,#1c1b1b"
color-link diff-added "#249746"
color-link diff-modified "#517fea"
color-link diff-deleted "#d75e46"

# Interface
color-link statusline "#908f8f,#141414"
color-link statusline.inactive "#626262,#171616"
color-link statusline.suggestions "#908f8f,#171616"
color-link tabbar "#908f8f,#171616"
color-link tabbar.active "#c0bfbf,#1c1b1b"
color-link message "#c0bfbf,#1c1b1b"
color-link error-message "bold #d75e46,#1c1b1b"

# Syntax
color-link comment "#626262"
color-link comment.bright "#626262"
color-link identifier "#c56e00"
color-link identifier.class "#008cc7"
color-link identifier.macro "#d35a87"
color-link identifier.var "#c0bfbf"
color-link constant "#c0bfbf"
color-link constant.bool "#d35a87"
color-link constant.number "#916fe3"
color-link constant.specialChar "#916fe3"
color-link constant.string "#798c00"
color-link constant.string.url "underline #008cc7"
color-link statement "#908f8f"
color-link symbol "#908f8f"
color-link symbol.brackets "#908f8f"
color-link symbol.operator "#908f8f"
color-link symbol.tag "#908f8f"
color-link preproc "#908f8f"
color-link preproc.shebang "#626262"
color-link type "#908f8f"
color-link type.keyword "#908f8f"
color-link special "#d35a87"
color-link underlined "underline #008cc7"
color-link error "italic underline #d75e46"
color-link todo "bold #a37f00"
color-link ignore "#383838"
